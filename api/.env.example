# Copy this file to api/.env and fill in real values.
# api/.env is gitignored — never commit real secrets.

# ── Database (Neon Postgres) ───────────────────────────────────────
PD_DB_HOST=YOUR_NEON_HOST_HERE
PD_DB_ENDPOINT_ID=YOUR_ENDPOINT_ID_HERE
PD_DB_USER=neondb_owner
PD_DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# ── SMTP (for OTP / password-reset emails) ─────────────────────────
PD_SMTP_HOST=smtp.gmail.com
PD_SMTP_PORT=587
PD_SMTP_USER=you@example.com
PD_SMTP_PASS=your-16-char-app-password
PD_SMTP_FROM=you@example.com
PD_SMTP_FROM_NAME=PaperDesk

# ── Auth ────────────────────────────────────────────────────────────
# REQUIRED — the app will refuse to start without this (>= 32 chars).
# Generate with: php -r "echo bin2hex(random_bytes(32));"
PD_JWT_SECRET=change_me_to_a_long_random_string

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API
# with credentials (Authorization header). No wildcard in production.
PD_ALLOWED_ORIGINS=https://your-production-domain.com

# ── Google Sign-In ──────────────────────────────────────────────────
PD_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# ── Angel One SmartAPI (broker feed) ────────────────────────────────
# From https://smartapi.angelone.in — see api/angel-config.php header
# comment for where each value comes from in the Angel One app.
PD_ANGEL_API_KEY=YOUR_API_KEY_HERE
PD_ANGEL_CLIENT_CODE=YOUR_CLIENT_CODE_HERE
PD_ANGEL_CLIENT_PIN=YOUR_PIN_HERE
PD_ANGEL_TOTP_SECRET=YOUR_TOTP_SECRET_HERE

# ── Telegram alerts bot ─────────────────────────────────────────────
# Get PD_TELEGRAM_BOT_TOKEN from @BotFather. PD_TELEGRAM_BOT_USERNAME
# is the bot's @username without the @ (BotFather shows it right
# after creation, e.g. PaperDeskAlertsBot).
PD_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
PD_TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME_HERE

# ── Admin/maintenance endpoints ─────────────────────────────────────
# Protects import-instruments.php, import-clean-instruments.php,
# export-bse-equity.php, angel-test.php — pass it as ?key=... or an
# X-Admin-Key header. Leave unset to keep these open (dev only).
# Generate with: php -r "echo bin2hex(random_bytes(16));"
PD_ADMIN_KEY=change_me_to_a_random_string

